diff --git a/wire/cube_framing_test.go b/wire/cube_framing_test.go
new file mode 100644
index 0000000..ead397e
--- /dev/null
+++ b/wire/cube_framing_test.go
@@ -0,0 +1,28 @@
+package wire
+
+import (
+ "encoding/binary"
+ "testing"
+ "github.com/nuriland/a2kit/internal/wiretest"
+)
+
+func TestStrictFamiliesRecoversObjectInsideBogusAlignedFrame(t *testing.T) {
+ d:=NewDecoder(Config{EmitUnlocked:true,StrictFamilies:true})
+ stream:=wiretest.AppendFrame(nil,0x00,0x36,8)
+ stream=wiretest.AppendFrame(stream,0x00,0x36,8)
+ stream=wiretest.AppendFrame(stream,0x00,0x36,8)
+ body:=[]byte{0xBE,0x46}
+ body=append(body,make([]byte,100)...)
+ body=wiretest.AppendFrame(body,0x34,0x36,24)
+ body=wiretest.AppendFrame(body,0x00,0x36,8)
+ body=wiretest.AppendFrame(body,0x00,0x36,8)
+ stream=binary.AppendUvarint(stream,uint64(len(body)+4))
+ stream=append(stream,body...)
+ feed(d,stream);d.Flush()
+ found:=false
+ for frame:=range d.Frames(){
+  if frame.Opcode==0x46BE {t.Fatal("bogus frame swallowed object")}
+  if frame.Opcode==0x3634 {found=true}
+ }
+ if !found {t.Fatal("object frame not recovered")}
+}
