--- /dev/null
+++ b/cmd/a2k/player_payload_test.go
@@ -0,0 +1,25 @@
+package main
+
+import (
+	"encoding/json"
+	"github.com/nuriland/a2kit"
+	"github.com/nuriland/a2kit/game"
+	"github.com/nuriland/a2kit/wire"
+	"testing"
+	"time"
+)
+
+func TestDecodedPlayerPreservesRawPayload(t *testing.T) {
+	message := a2kit.Message{Frame: wire.Frame{Opcode: 0x3645, Payload: []byte{0x34, 0x36, 0x01}}, Event: game.Player{Entity: 7, Name: "TestPlayer"}}
+	var line map[string]json.RawMessage
+	if err := json.Unmarshal(marshal(message, time.Time{}), &line); err != nil {
+		t.Fatal(err)
+	}
+	var payload string
+	if err := json.Unmarshal(line["payload"], &payload); err != nil {
+		t.Fatal(err)
+	}
+	if payload != "34 36 01" {
+		t.Fatalf("raw Player bytes lost: %q", payload)
+	}
+}
