<Window x:Class="Aion2MapOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aion2 Map Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized">

    <Grid>
        <Canvas x:Name="OverlayCanvas"/>
        <Border x:Name="CubeBanner"
                Background="#EA161D23"
                BorderBrush="#FFFFCD67"
                BorderThickness="2"
                CornerRadius="12"
                Padding="34,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,32,0,0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Text="CUBE FOUND"
                           Foreground="#FFFFCD67"
                           FontSize="38"
                           FontWeight="Bold"
                           TextAlignment="Center"/>
                <TextBlock x:Name="CubeCountText"
                           Foreground="#FFF5F7FA"
                           FontSize="18"
                           TextAlignment="Center"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
